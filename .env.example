# --- LLM ---
OPENAI_API_KEY=your-openai-key-here
MODEL_NAME=gpt-4o-mini

# --- Memory backend ---
# true  -> persist conversations to a SQLite file (survives restarts)
# false -> in-memory only (lost when the process exits)
USE_SQLITE_MEMORY=true
MEMORY_DB_PATH=conversation_memory.sqlite

# --- Bonus: LangSmith tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=langgraph-memory-demo
